# Copy this file to `.env` and fill in your keys.
# The app runs without them — when Gemini is unavailable or out of quota,
# Groq is tried automatically, then the bundled deterministic agents.
#Jarvislabs AI  environment variables
JARVIS_API_KEY= your-jarvislabs-api-key
JARVIS_MODEL= model_name

# Primary provider: Gemini (free tier ~20 requests/day on gemini-3.6-flash)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Fallback provider: Groq (groq.com, OpenAI-compatible, fast inference)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Temporal local development defaults
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=abridgeai-planning
TEMPORAL_TLS=false
# For Temporal Cloud, set TEMPORAL_TLS=true and provide TEMPORAL_API_KEY.
# TEMPORAL_API_KEY=

# Maximum duration for each outbound provider/GitHub HTTP request
AI_PROVIDER_TIMEOUT_MS=30000

PORT=3001